{
    "name": "@gtindependence/node-common",
    "version": "7.0.0",
    "description": "This repo houses our shared node functions and node handlers",
    "keywords": [
        "Typescript"
    ],
    "license": "ISC",
    "author": "TeamMaestro + GTIndependence",
    "homepage": "https://github.com/gtindepedence/node-common",
    "repository": {
        "type": "git",
        "url": "https://github.com/gtindepedence/node-common.git"
    },
    "bugs": {
        "url": "https://github.com/gtindepedence/node-common/issues"
    },
    "private": false,
    "files": [
        "index.js",
        "index.d.ts",
        "modules/**/*.js",
        "modules/**/*.d.ts"
    ],
    "scripts": {
        "clean": "rm -f *.js && rm -f *.d.ts && rm -Rf modules",
        "test": "jest",
        "watch": "tsc -w",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "prepack": "npm run lint && npm run build",
        "postpublish": "git push && git push --tags",
        "postpack": "npm run clean",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --check src"
    },
    "devDependencies": {
        "@faker-js/faker": "9.9.0",
        "@types/config": "3.3.5",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.5.2",
        "prettier": "^3.9.10",
        "ts-jest": "^29.1.1",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.72.0"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@sentry/node": "^10.39.0",
        "config": "^3.3.9",
        "deepmerge-ts": "^8.0.2",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-plugin-import-x": "^4.17.1",
        "log4js": "6.9.1"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node"
    }
}
